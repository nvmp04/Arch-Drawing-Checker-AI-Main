# Token BE gửi khi gọi MAIN (khớp AI_SERVICE_TOKEN bên BE). Header: Authorization: Bearer <token> (D-13).
MAIN_SERVICE_TOKEN=change-me-ai-token
# Token MAIN gửi trong header x-internal-token khi gọi callback BE (khớp INTERNAL_CALLBACK_TOKEN bên BE).
MAIN_CALLBACK_TOKEN=change-me-callback-token
# Ngưỡng tin cậy — khớp CONFIDENCE_THRESHOLD của BE/FE.
MAIN_CONFIDENCE_THRESHOLD=0.8
# Thư mục tạm lưu PDF tải về.
MAIN_WORK_DIR=data/work
# Viewer debug kết quả ingest theo job, phục vụ tại /debug/inspect/ — KHÔNG xác thực, tắt khi triển khai.
MAIN_INSPECT_ENABLED=true
MAIN_INSPECT_DIR=data/inspect
# Độ phân giải ảnh nền viewer (0 = không render).
MAIN_INSPECT_DPI=110
# Bộ rule MOCK khi BE gửi rules: [] (hợp đồng v0) — đợt thử rule engine (D-16). Để trống để tắt.
MAIN_MOCK_RULESET=samples/criteria/ruleset-4sao.json
