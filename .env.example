# Token BE gửi khi gọi MAIN (khớp AI_SERVICE_TOKEN bên BE). Header: Authorization: Bearer <token> (D-13).
MAIN_SERVICE_TOKEN=change-me-ai-token
# Token MAIN gửi trong header x-internal-token khi gọi callback BE (khớp INTERNAL_CALLBACK_TOKEN bên BE).
MAIN_CALLBACK_TOKEN=change-me-callback-token
# Ngưỡng tin cậy — khớp CONFIDENCE_THRESHOLD của BE/FE.
MAIN_CONFIDENCE_THRESHOLD=0.8
# Thư mục tạm lưu PDF tải về.
MAIN_WORK_DIR=data/work
# Viewer debug kết quả ingest theo job, phục vụ tại /debug/inspect/ — KHÔNG xác thực, tắt khi triển khai.
MAIN_INSPECT_ENABLED=true
MAIN_INSPECT_DIR=data/inspect
# Độ phân giải ảnh nền viewer (0 = không render).
MAIN_INSPECT_DPI=110
# Chế độ chấm cho đối tác (máy Oracle, D-24): đặt mật khẩu → /debug/* đòi đăng nhập, tên đăng nhập = người chấm.
# MAIN_REVIEW_PASSWORD=
# Chỉ mở viewer + API chấm (tắt API nhận việc từ BE).
MAIN_REVIEW_ONLY=false
# Chuỗi kết nối Neon: có giá trị → kết quả chấm lưu Postgres thay cho data/reviews (bắt buộc trên Render; trên máy dev để kéo về).
# MAIN_REVIEWS_DATABASE_URL=<chuỗi kết nối thật từ Neon → Connect>
# Bộ rule MOCK khi BE gửi rules: [] (hợp đồng v0) — đợt thử rule engine (D-16). Để trống để tắt.
MAIN_MOCK_RULESET=samples/criteria/ruleset-4sao.json

# --- AI (D-22). MẶC ĐỊNH TẮT — gọi Claude tốn tiền, chỉ người dùng tự bật. ---
# off | claude (gọi API thật) | replay (phát lại các lần gọi thật đã ghi, miễn phí)
MAIN_AI_PROVIDER=off
# claude-opus-5-5 ($4/$20 / 1M token) · claude-sonnet-5-5 ($2/$10) · claude-haiku-5-5 ($0.10/$0.50)
MAIN_AI_MODEL=claude-opus-5-5
MAIN_AI_EFFORT=medium
# Hạn mức tháng phía MAIN (đặt thêm giới hạn chi tiêu trong Anthropic Console) + trần một lần kiểm một hồ sơ.
MAIN_AI_MONTHLY_BUDGET_USD=5
MAIN_AI_MAX_USD_PER_RUN=1
# API key Anthropic — chỉ để trong .env (không commit).
MAIN_ANTHROPIC_API_KEY=
